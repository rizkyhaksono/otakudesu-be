{
  "name": "otakudesu-be",
  "version": "3.0.0",
  "private": true,
  "description": "Community API for anime, comics, movies and Indonesian live TV",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/shared tests/anime tests/comic tests/movie tests/tv tests/news tests/server.test.ts",
    "test:live": "bun test tests/live --timeout 30000"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "eslint": "10.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
