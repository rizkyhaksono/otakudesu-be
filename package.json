{
  "name": "otakudesu-be",
  "version": "3.0.0",
  "private": true,
  "description": "Community API for anime, comics, movies and Indonesian live TV",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun run assemble",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/shared tests/anime tests/comic tests/movie tests/tv",
    "test:live": "bun test tests/live --timeout 30000",
    "assemble": "cp -R public .next/standalone/ 2>/dev/null || true; mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/",
    "start:dev": "next start"
  },
  "dependencies": {
    "@scalar/nextjs-api-reference": "^0.11.14",
    "cheerio": "^1.2.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "5.9.3"
  }
}
