# ── Anime (scraped) ───────────────────────────────────────────────────────────
# Upstream Otakudesu origin. Required. `BASEURL` is accepted as a legacy alias.
ANIME_BASE_URL=https://otakudesu.blog

# ── Comic (scraped, Laravel + Inertia) ────────────────────────────────────────
COMIC_BASE_URL=https://kiryuuid.net

# ── Movie / TV series (TMDB API) ──────────────────────────────────────────────
# Free account -> themoviedb.org -> Settings -> API -> "API Read Access Token".
# Optional: without it the movie endpoints return empty results instead of failing.
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=id-ID

# Ordered list of enabled embed players for the movie/TV watch page.
MOVIE_EMBED_PROVIDERS=2embed,videasy,vidsrc,vidsrccc,vidlink,embedsu,autoembed

# ── Live TV (iptv-org index) ──────────────────────────────────────────────────
IPTV_API_URL=https://iptv-org.github.io/api
TV_COUNTRY=ID

# ── Public site (used to build absolute links, e.g. the .ics calendar) ────────
SITE_URL=https://otakudesu.natee.my.id

# ── Radio (radio-browser open database) ───────────────────────────────────────
# Any radio-browser mirror works; the country comes from TV_COUNTRY above.
RADIO_API_URL=https://de1.api.radio-browser.info

# ── News (RSS) ────────────────────────────────────────────────────────────────
# Any RSS 2.0 feed. Defaults to the Anime News Network weekly edition.
NEWS_FEED_URL=https://www.animenewsnetwork.com/all/rss.xml?ann-edition=w

# ── Tools (open, unauthenticated third-party APIs) ─────────────────────────────
ANIMECHAN_API_URL=https://api.animechan.io/v1
TRACEMOE_API_URL=https://api.trace.moe
ANIMETHEMES_API_URL=https://api.animethemes.moe

# Shinigami rotates its content domain constantly; this portal publishes the
# current one as the first entry of /links.json.
SHINIGAMI_PORTAL_URL=https://shinigami.to

# Public origin advertised by the OpenAPI document. Only needed when this
# service runs behind a proxy that does not send x-forwarded-* headers.
API_PUBLIC_URL=

# ── Optional third-party adapter (disabled when empty) ────────────────────────
MOVIEBOX_API_URL=

# ── Limits ────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120

# Signing key for HLS proxy URLs. Leave empty for a single instance (a random
# key is generated per process); set an explicit value when running replicas.
HLS_PROXY_SECRET=
